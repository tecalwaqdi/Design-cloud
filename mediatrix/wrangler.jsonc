{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mediatrix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Database for content, stats and contact messages (created automatically on first deploy)
  "d1_databases": [{ "binding": "DB", "database_name": "mediatrix-db" }],
  // Bucket for uploaded images / videos (created automatically on first deploy)
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mediatrix-media" }],
  "observability": { "enabled": true }
}
