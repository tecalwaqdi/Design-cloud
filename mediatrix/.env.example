# Password for the first login to /admin (change it from the dashboard afterwards)
ADMIN_PASSWORD=change-me
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`)
AUTH_SECRET=replace-with-a-long-random-string
# Where content.json, stats.json and uploads/ are stored (mount a volume here in production)
DATA_DIR=./data
# Public site URL (used for SEO / sitemap)
SITE_URL=https://mediatrix.example
