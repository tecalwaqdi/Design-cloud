{
  // Alternative deploy config: same Worker, D1 and R2 as ../wrangler.jsonc,
  // but static files are uploaded through Workers Sites (KV).
  // Use: npx wrangler deploy -c deploy/wrangler.sites.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mediatrix",
  "main": "sites-worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "site": { "bucket": "../.open-next/assets" },
  "d1_databases": [{ "binding": "DB", "database_name": "mediatrix-db" }],
  // Uploaded images / videos (Workers KV, created automatically). To use R2 instead,
  // enable R2 in the dashboard and add: "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mediatrix-media" }]
  "kv_namespaces": [{ "binding": "MEDIA_KV" }],
  "workers_dev": true,
  // Custom domain (DNS records are created automatically)
  "routes": [
    { "pattern": "mediatrixglobal.com", "custom_domain": true },
    { "pattern": "www.mediatrixglobal.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
